{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slot": {
      "enum": [
        "palette",
        "ground",
        "marks",
        "type",
        "composition",
        "progression",
        "motion",
        "transitions",
        "finish",
        "host"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "slot",
    "requires",
    "provides"
  ]
}
